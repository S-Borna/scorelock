# ── ScoreLock Environment Variables ────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://scorelock.saidborna.com
BASE_URL=https://scorelock.saidborna.com

# ── Database (PostgreSQL + TimescaleDB) ────────────────────
POSTGRES_USER=scorelock
POSTGRES_PASSWORD=scorelock_dev
POSTGRES_DB=scorelock
DATABASE_URL=postgresql+asyncpg://scorelock:scorelock_dev@db:5432/scorelock

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Auth ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── API-Football (https://www.api-football.com/) ──────────
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ── football-data.org (https://www.football-data.org/) ────
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# ── The Odds API (https://the-odds-api.com/) ──────────────
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# ── Stripe (https://stripe.com/) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# ── Anthropic (sentiment analysis) ────────────────────────
ANTHROPIC_API_KEY=

# ── Sentry (error monitoring) ─────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Deployment (Railway) ───────────────────────────────────
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# ── Cloudflare ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# ── Grafana ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
