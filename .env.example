# ── ScoreLock Environment Variables ────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://scorelock.saidborna.com
BASE_URL=https://scorelock.saidborna.com

# ── Database (PostgreSQL + TimescaleDB) ────────────────────
POSTGRES_USER=scorelock
POSTGRES_PASSWORD=scorelock_dev
POSTGRES_DB=scorelock
DATABASE_URL=postgresql+asyncpg://scorelock:scorelock_dev@db:5432/scorelock

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Auth ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── API-Football (https://www.api-football.com/) ──────────
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ── Stripe (https://stripe.com/) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# ── Anthropic (sentiment analysis) ────────────────────────
ANTHROPIC_API_KEY=

# ── Deployment (Railway) ───────────────────────────────────
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# ── Cloudflare ─────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# ── Grafana ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
